# HubSpot Email MCP Server — environment variables
# Copy this file to .env and fill in your real values.
# .env is gitignored; never commit your actual token.

# Required. HubSpot API token, sent as a Bearer token.
# Recommended: a Service Key (Settings → Integrations → Service Keys), which
# is HubSpot's current path for system-to-system API access and stays valid
# even if the creator leaves the account.
# A legacy Private App token (pat-...) also works identically.
# Either way, grant the marketing-email scope (read; plus write to create/update drafts).
HUBSPOT_ACCESS_TOKEN=your-service-key-or-private-app-token

# Optional. Your HubSpot portal (hub) ID.
# When set, list_emails and get_email results include a clickable hubspotUrl
# of the form https://app.hubspot.com/email/{HUBSPOT_PORTAL_ID}/details/{emailId}.
# Find it in the URL when logged into HubSpot, or the top-right account menu.
# If omitted, the server still works — it just omits hubspotUrl.
HUBSPOT_PORTAL_ID=your-portal-id
